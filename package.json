{
  "name": "@leejkee/obs-live-overlay",
  "version": "0.7.0-beta.0",
  "description": "由本地控制台管理、用于 OBS Browser Source 的实时等候队列 Overlay",
  "type": "module",
  "exports": {
    "./native": {
      "types": "./native/index.d.cts",
      "default": "./native/index.cjs"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./public/*": "./public/*"
  },
  "bin": {
    "obs-live-overlay": "dist/cli.js"
  },
  "files": [
    "dist/",
    "public/",
    "native/",
    "prebuilds/",
    "docs/node-addon.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "install": "node -e \"/* Native builds are explicit; packaged prebuilds need no compiler. */\"",
    "build:native": "node-gyp rebuild --arch=x64",
    "build:native:fixture": "node-gyp rebuild --arch=x64 -- -Dsmtc_fixture=1",
    "test:media:native": "npm run build && node scripts/check-native-fixture.cjs",
    "package:native": "prebuildify --napi --arch=x64 --target=20.0.0",
    "test:native": "npm run build && node --test test/native/runtime.test.cjs",
    "test:package:native": "npm run build && node scripts/check-native-package.cjs",
    "dev": "tsx watch src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "prepack": "npm run build",
    "pack:local": "npm pack",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p test/native/tsconfig.json",
    "verify": "npm run check && npm test && npm run build",
    "screenshots:release": "npm run build && node scripts/capture-release-screenshots.mjs"
  },
  "dependencies": {
    "node-gyp-build": "^4.8.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "node-addon-api": "8.9.2",
    "node-gyp": "12.4.0",
    "prebuildify": "6.0.1",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leejkee/obs-live-overlay.git"
  },
  "homepage": "https://github.com/leejkee/obs-live-overlay#readme",
  "bugs": {
    "url": "https://github.com/leejkee/obs-live-overlay/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
