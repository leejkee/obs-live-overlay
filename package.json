{
  "name": "@leejkee/obs-live-overlay",
  "version": "0.1.2",
  "description": "由本地控制台管理、用于 OBS Browser Source 的实时等候队列 Overlay",
  "type": "module",
  "bin": {
    "obs-live-overlay": "dist/cli.js"
  },
  "files": [
    "dist/",
    "public/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "prepack": "npm run build",
    "pack:local": "npm pack",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leejkee/obs-live-overlay.git"
  },
  "homepage": "https://github.com/leejkee/obs-live-overlay#readme",
  "bugs": {
    "url": "https://github.com/leejkee/obs-live-overlay/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
